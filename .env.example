# 이 파일을 .env로 복사한 뒤 값을 채워야 함 (.env는 커밋하지 않기떄문)

# compose 프로젝트 이름 (DB 볼륨을 기존 프로젝트와 분리하기 위해 일부러 작성)
COMPOSE_PROJECT_NAME=homefin-local

MYSQL_DATABASE=homefinmate
MYSQL_USER=hfmuser

# 비밀값: 직접 정한 값으로 바꾸기!
MYSQL_ROOT_PASSWORD=여기에_root_비밀번호
MYSQL_PASSWORD=여기에_hfmuser_비밀번호

# 소득 암호화 키 (32자, 바꾸면 기존 암호문 복호화 불가)
ENCRYPTION_KEY=여기에_32자_암호화_키

# 토큰 서명 키
JWT_SECRET=여기에_64자_JWT_비밀키

# 토큰 유효 기간
# JWT_EXPIRATION_MS=86400000

# RiskWatch 서비스 토큰 서명 키 (RiskWatch .env의 HOMEFIN_TOKEN_SECRET과 같은 값, JWT_SECRET과 다른 값, 32바이트 이상)
RISKWATCH_TOKEN_SECRET=여기에_RiskWatch와_같은_32자_이상_비밀키

# FinFlow 서비스 토큰 서명 키 (FinFlow .env의 SERVICE_TOKEN_SECRET과 같은 값, JWT_SECRET·RISKWATCH_TOKEN_SECRET과 다른 값, 32바이트 이상)
FINFLOW_TOKEN_SECRET=여기에_FinFlow와_같은_32자_이상_비밀키

# FinFlow 서버 주소 (비워두면 기본값 http://localhost:8110, 세 서비스를 함께 띄우면 서비스 이름으로 바뀜)
# FINFLOW_BASE_URL=http://localhost:8110

# RiskWatch 서버 주소 (비워두면 기본값 http://localhost:8120, RiskWatch가 떠 있지 않으면 연결 실패 => fallback)
# RISKWATCH_BASE_URL=http://localhost:8120

# CORS 허용 출처 (화면 주소, 쉼표로 여러 개)
# CORS_ALLOWED_ORIGINS=http://localhost:3100

# Swagger UI·API 문서 공개 (로컬에서 볼 때만 true, 기본 false)
# SWAGGER_ENABLED=true

# 기록 보관 기간 (일, 지난 기록은 매일 03:00에 삭제)
# RETENTION_LOGIN_FAILURE_DAYS=90
# RETENTION_AUDIT_DAYS=365

# 관리자로 지정할 이메일 (쉼표로 여러 개). 가입하면 ADMIN, 이미 가입했으면 서버 시작 시 ADMIN으로 바뀜
ADMIN_EMAILS=

# 로그인 쿠키 Secure 속성 (HTTPS로 운영하면 true, 로컬 http compose는 false)
# COOKIE_SECURE=false
