{
  "uid": "finsight-services",
  "title": "FinSight 서비스",
  "tags": [
    "finsight"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "서비스 (에이전트 기본 지표)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "초당 요청 수",
      "description": "상태 확인 요청 제외",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{service_name=~\"homefin-backend|homefin-python|finflow|riskwatch\", http_route!~\"/actuator/health|/health\"}[5m]))",
          "legendFormat": "{{service_name}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "5xx 비율",
      "description": "서버 오류 응답 / 전체 응답 (5분)",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (service_name) (rate(http_server_request_duration_seconds_count{service_name=~\"homefin-backend|homefin-python|finflow|riskwatch\", http_response_status_code=~\"5..\"}[5m])) or 0 * sum by (service_name) (rate(http_server_request_duration_seconds_count{service_name=~\"homefin-backend|homefin-python|finflow|riskwatch\"}[5m]))) / sum by (service_name) (rate(http_server_request_duration_seconds_count{service_name=~\"homefin-backend|homefin-python|finflow|riskwatch\"}[5m]))",
          "legendFormat": "{{service_name}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "응답 시간 p95",
      "description": "상태 확인 요청 제외, 5분 창",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (service_name, le) (rate(http_server_request_duration_seconds_bucket{service_name=~\"homefin-backend|homefin-python|finflow|riskwatch\", http_route!~\"/actuator/health|/health\"}[5m])))",
          "legendFormat": "{{service_name}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "외부 호출 응답 시간 p95",
      "description": "서비스가 다른 서비스를 부른 시간 (HomeFin → RiskWatch·FinFlow·Python, FinFlow → RiskWatch)",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (service_name, server_address, le) (rate(http_client_request_duration_seconds_bucket{service_name=~\"homefin-backend|homefin-python|finflow|riskwatch\"}[5m])))",
          "legendFormat": "{{service_name}} → {{server_address}}",
          "range": true
        }
      ]
    },
    {
      "type": "row",
      "title": "업무 지표",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "id": 6,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "HomeFin 통합 분석의 RiskWatch 결과",
      "description": "5분 동안 건수 (EVALUATED 판정 / UNAVAILABLE 응답 없음 / NOT_EVALUATED 입력 모자람)",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (increase(hfm_riskwatch_evaluations_total[5m]))",
          "legendFormat": "{{status}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HomeFin 신청의 FinFlow 결과",
      "description": "5분 동안 건수 (RECEIVED 접수 / REPLAYED 같은 키 재전송 / CONFLICT 진행 중 신청 / UNAVAILABLE 응답 없음)",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (increase(hfm_loan_applications_total[5m]))",
          "legendFormat": "{{outcome}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "FinFlow 신청 상태 변화",
      "description": "5분 동안 건수 (RECEIVED는 새 접수)",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (to_status) (increase(finflow_application_status_changes_total[5m]))",
          "legendFormat": "{{to_status}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "FinFlow 심사 시작의 RiskWatch 결과",
      "description": "5분 동안 건수",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (increase(finflow_riskwatch_evaluations_total[5m]))",
          "legendFormat": "{{status}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "RiskWatch 판정",
      "description": "5분 동안 평가 API 건수 (요청 서버별)",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (source_system, verdict) (increase(riskwatch_evaluations_total[5m]))",
          "legendFormat": "{{source_system}} {{verdict}}",
          "range": true
        }
      ]
    }
  ],
  "description": "HomeFin·FinFlow·RiskWatch 요청 수, 오류율, 응답 시간, 업무 지표 (observability/grafana에서 자동 등록)"
}
